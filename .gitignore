# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/

# Images are NOT versioned. `python -m src.data download` fetches the exact
# files (checksummed release assets); the iNaturalist sets can also be rebuilt
# from their manifest.csv. READMEs, manifests and the session split stay in git.
/data/raw/helopeltis/train/
/data/raw/helopeltis/valid/
/data/raw/helopeltis/test/
/data/raw/helopeltis_negatives/train/
/data/raw/helopeltis_negatives/valid/
/data/raw/helopeltis_negatives/test/
/data/raw/flush_stages/*/
/data/raw/insect_families/*/
*.zip
release_assets/

# Model binaries: heavy and regenerable (the two the pipeline loads come with
# `python -m src.data download`). Metrics JSON and results.csv ARE versioned.
*.pt
*.pth
*.onnx
*.tflite
*.pkl
*.cache
runs/
models/**/weights/
models/flush_stage_tf/
models/**/*.png
models/**/*.jpg

# Generated by `src.data split` / `src.train`: absolute, machine-specific paths.
models/helopeltis_v2.yaml
models/split_*.txt
models/detector_*.txt
models/**/args.yaml

